# Copy to backend/.env for local development. NEVER commit the real .env.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5199
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# ---- SQL database: SQLite locally, PostgreSQL (Render) when hosted ----
DATABASE_URL=sqlite:///./civiclens.db
# DATABASE_URL=postgresql://user:password@host:5432/civiclens   (Render "Internal Database URL")

# ---- MongoDB (user logins). Leave empty to store users in the SQL `users` table locally ----
MONGODB_URI=
MONGODB_DB_NAME=civiclens

JWT_SECRET_KEY=replace_with_a_long_random_secret

# ---- AI: OpenAI primary, Ollama backup, rules last resort ----
AI_PROVIDER_ORDER=openai,ollama,rules
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=

# ---- Seeding / demo ----
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo@12345
PUBLIC_BASE_URL=http://localhost:5173

# ---- Geocoding (OpenStreetMap Nominatim; set GEOCODER_PROVIDER=none to disable) ----
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=CivicLens-prototype/1.0

# ---- Google Sign-In (public client id only; the client SECRET is never needed or stored) ----
GOOGLE_CLIENT_ID=
