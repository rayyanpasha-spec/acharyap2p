# Public frontend config only. NEVER put secrets here (VITE_ vars are visible in the browser).
VITE_API_BASE_URL=http://127.0.0.1:8010/api/v1
VITE_WS_BASE_URL=ws://127.0.0.1:8010
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_MAP_LATITUDE=12.9716
VITE_DEFAULT_MAP_LONGITUDE=77.5946
VITE_DEFAULT_MAP_ZOOM=12
VITE_DEFAULT_CITY_LABEL=Bengaluru, Karnataka
# 3D map basemap style (default: OpenFreeMap liberty, no key needed)
VITE_CITY_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Public Google OAuth client id (fallback if the API cannot be reached). Never put the client SECRET here.
VITE_GOOGLE_CLIENT_ID=
